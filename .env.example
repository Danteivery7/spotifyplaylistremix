# Web app
# Public Spotify playlists work without Spotify OAuth credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUDIO_ENGINE_URL=http://localhost:8000

# Optional Spotify OAuth fallback for private / owned / collaborative playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Audio engine
MEDIA_LIBRARY_PATH=./media
OUTPUT_PATH=./engine/output
ENABLE_STEMS=false
STEM_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt