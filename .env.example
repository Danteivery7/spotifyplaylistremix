# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: preconfigure the public Spotify Client ID. If omitted, the site lets
# you paste the Client ID once and stores it in the browser for PKCE login.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Optional permanent YouTube Data API v3 key. If omitted, the site lets you
# paste a key into the browser for YouTube matching and public playlist lookup.
YOUTUBE_API_KEY=
AUDIO_ENGINE_URL=http://localhost:8000

# Audio engine
MEDIA_LIBRARY_PATH=./media
OUTPUT_PATH=./engine/output
ENABLE_STEMS=false
STEM_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt

# Optional automatic source providers. The engine only uses providers that
# explicitly expose a downloadable file for application use.
JAMENDO_CLIENT_ID=
