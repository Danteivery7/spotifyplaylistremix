# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: preconfigure the public Spotify Client ID. If omitted, the site lets
# you paste the Client ID once and stores it in the browser for PKCE login.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Reusable YouTube Data API v3 key. This can be the same Google Cloud API key
# used by the shared-music/Hangout-style project if that key is allowed for this app.
YOUTUBE_API_KEY=
AUDIO_ENGINE_URL=http://localhost:8000

# Audio engine
MEDIA_LIBRARY_PATH=./media
OUTPUT_PATH=./engine/output
ENABLE_STEMS=false
STEM_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt

# Optional automatic source providers. The engine only materializes tracks when
# the provider explicitly exposes a downloadable file and the metadata match is strong.
JAMENDO_CLIENT_ID=

# SoundCloud public-resource access. Client credentials are exchanged server-side
# and cached/refreshed by the engine. Never expose the Client Secret in browser code.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Optional manual token override, useful for testing.
SOUNDCLOUD_ACCESS_TOKEN=

# Audius backend credentials. API key may be used for read/search calls; bearer token
# stays server-side. Only ungated tracks marked downloadable are materialized.
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
AUDIUS_APP_NAME=PlaylistRemixStudio
